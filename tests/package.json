    "dayjs": "^1.10.4",
    "eslint": "^7.11.0",
    "husky": "^9.1.7",
    "jest-junit": "^11.1.0",
    "lint-staged": "^16.1.0",
    "mocha-junit-reporter": "^2.2.1",
    "prettier": "^2.8.8",
    "typescript": "^5.5.4"
